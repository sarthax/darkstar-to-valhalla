require("scripts/globals/status");
require("scripts/globals/magic");
require("scripts/globals/msg");

-----------------------------------
-- onAdditionalEffect Action
-----------------------------------

function onAdditionalEffect(player,target,damage)
    -- Each status rolls independently so several can land on one mob. Resistance is NOT rolled (afflictions ignore it).
    local applied, last = 0, nil;
    local list = {
        {EFFECT_POISON,    SUBEFFECT_POISON,    <POISON_CHANCE>, <POISON_POWER>, <POISON_DURATION>},
        {EFFECT_PARALYSIS, SUBEFFECT_PARALYSIS, <PARA_CHANCE>,   <PARA_POWER>,   <PARA_DURATION>},
        {EFFECT_BIND,      0 --[[no SUBEFFECT_BIND constant in DSP status.lua; confirm animation id]], <BIND_CHANCE>,   <BIND_POWER>,   <BIND_DURATION>},
    };
    for _, e in ipairs(list) do
        if (math.random(0,99) < e[3] and not target:hasStatusEffect(e[1])) then
            if (target:addStatusEffect(e[1], e[4], 0, e[5])) then applied = applied + 1; last = e; end
        end
    end
    if (applied == 0) then return 0,0,0; end
    return last[2], msgBasic.ADD_EFFECT_STATUS, last[1];
end;
