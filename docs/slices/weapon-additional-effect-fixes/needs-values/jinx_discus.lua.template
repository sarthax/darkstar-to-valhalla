function onAdditionalEffect(player,target,damage)
    local chance = <CHANCE>;

    if (math.random(0,99) >= chance or applyResistanceAddEffect(player,target,ELE_DARK,0) <= 0.5) then
        return 0,0,0;
    else
        if (not target:hasStatusEffect(EFFECT_CURSE_I)) then
            target:addStatusEffect(EFFECT_CURSE_I, <POWER>, 0, <DURATION>);
        end
        return 0, msgBasic.ADD_EFFECT_STATUS, EFFECT_CURSE_I;
    end
end;
